+# Add a small helper that waits for Redis if REDIS_URL or REDIS_HOST is set. This preserves legacy deployment contract.
+RUN printf '#!/usr/bin/env python3\nimport os, time, socket, re\nREDIS_URL=os.getenv("REDIS_URL")\nif REDIS_URL:\n    m=re.match(r".*://([^:/]+)(?::(\\d+))?", REDIS_URL)\n    if m:\n        host=m.group(1); port=int(m.group(2) or 6379)\n    else:\n        host=None; port=6379\nelse:\n    host=os.getenv("REDIS_HOST")\n    port=int(os.getenv("REDIS_PORT") or 6379) if os.getenv("REDIS_HOST") else None\nif host:\n    while True:\n        try:\n            s=socket.socket(); s.settimeout(2); s.connect((host, port)); s.close(); break\n        except Exception:\n            time.sleep(1)\n' > /wait_for_redis.py && chmod +x /wait_for_redis.py
+
+CMD ["sh", "-c", "python /wait_for_redis.py && uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
